<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/viewBackgroundItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/viewer_info_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvFechaHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="15/05/2026"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/viewBackgroundItem"
        app:layout_constraintStart_toStartOf="@id/viewBackgroundItem"
        app:layout_constraintTop_toTopOf="@id/viewBackgroundItem" />

    <TextView
        android:id="@+id/tvMenuInfoHistorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="Lun: Ensalada Caesar\nMar: Milanesa con Puré\nMié: Arroz con Pollo\nJue: Arroz con Pollo\nVie: Arroz con Pollo"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:singleLine="false"
        android:maxLines="15"
        android:ellipsize="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvFechaHistorial"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>